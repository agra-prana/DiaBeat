# ==============================================================================
# DiaBeat - Environment Variables Template
# Salin file ini menjadi .env dan isi dengan kredensial Anda
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (Wajib untuk Analisis Kesehatan & Smart Input)
# Dapatkan di: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE D1 DATABASE (Wajib untuk Database Cloud D1)
# Dapatkan di: Cloudflare Dashboard -> Storage & Databases -> D1 SQL Database
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_d1_permissions

# ------------------------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION (Wajib untuk Google Sign-In & Email/Password)
# Dapatkan di: Firebase Console -> Project Settings -> General -> Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
