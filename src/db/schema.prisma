// DiaBeat Database Schema (PostgreSQL / Supabase / SQLite)
// Prisma Schema for production database transformation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile?

  activities  ActivityLog[]
  diets       DietLog[]
  sleepLogs   SleepLog[]
  screenTimes ScreenTimeLog[]
  insights    DailyInsight[]

  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  age       Int
  height    Float    // cm
  weight    Float    // kg
  gender    String?  // "male" | "female" | "other"
  targetCal Int      @default(2000)
  targetSteps Int    @default(10000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  time      String   // HH:mm or "07:30"
  name      String
  calories  Int      // kcal burned
  steps     Int?     @default(0)
  distance  Float?   @default(0) // km
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("activity_logs")
}

model DietLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  time      String   // HH:mm or "Makan Siang"
  name      String
  calories  Int      // kcal consumed
  protein   Float?   // grams
  carbs     Float?   // grams
  fat       Float?   // grams
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("diet_logs")
}

model SleepLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  duration  String   // e.g. "7j 30m"
  minutes   Int      // total minutes for calculation
  quality   String   // "Sangat Baik" | "Baik" | "Cukup" | "Kurang"
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("sleep_logs")
}

model ScreenTimeLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  app       String
  duration  String   // e.g. "2j 15m"
  minutes   Int      // total minutes for calculation
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("screentime_logs")
}

model DailyInsight {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  score       Int      // 0 - 100
  risk        String   // "Rendah" | "Sedang" | "Tinggi"
  analysis    String   @db.Text
  dietAdvice  String   @db.Text
  sleepAdvice String   @db.Text
  createdAt   DateTime @default(now())

  @@unique([userId, date])
  @@map("daily_insights")
}
